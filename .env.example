DATABASE_PATH=data/monitor.db
POLL_INTERVAL_HOURS=8
SCHEDULER_RUN_IMMEDIATELY=true
PORT=8080
LOG_LEVEL=INFO

# Slack: use an installed bot token, or configure OAuth client credentials.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
PUBLIC_BASE_URL=http://localhost:8080

TWITTERAPI_IO_API_KEY=
TWITTER_MAX_PAGES=3
TWITTER_LOOKBACK_DAYS=7
TWITTER_CURRENT_BATCHES=F26,W27,S27

# LinkedIn posts via HarvestAPI's Apify actor.
# LINKEDIN_TOTAL_POSTS is the cycle-wide upper bound, split across search queries
# (HarvestAPI maxPosts is per query, so this is allocated rather than sent raw).
APIFY_API_TOKEN=
LINKEDIN_TOTAL_POSTS=50
LINKEDIN_ACTOR_ID=buIWk2uOUzTmcLsuB
LINKEDIN_ACTOR_BUILD_ID=ASBzmjLXGQlvadkLr

# Official YC alerts: unseen slug AND launched_at within this many days.
# That matches the bounty ("newly added companies / new batch listings") without
# treating a 2022 restoration as new. The daily changes feed is health-only.
YC_LATEST_CHANGES_URL=https://yc-oss.github.io/api/changes/latest.json
YC_OFFICIAL_ALERT_MAX_AGE_DAYS=7

# Official a16z Speedrun public companies API. The bounty calls this "YC Speedrun",
# but the verified Speedrun program and directory are operated by Andreessen Horowitz.
YC_SPEEDRUN_URL=https://speedrun-api.a16z.com/api/companies/companies/

POND_ACCESS_KEY=

# Optional GPT noise classifier; unset key uses deterministic rules only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_MAX_CONCURRENCY=4
OPENAI_MIN_CONFIDENCE=0.65
OPENAI_IMMEDIATE_MIN_CONFIDENCE=0.9
OPENAI_MAX_CALLS_PER_CYCLE=25
OPENAI_MAX_CALLS_PER_DAY=100
MAX_TWITTER_PAGES_PER_DAY=48
MAX_LINKEDIN_POSTS_PER_DAY=150
SLACK_OPS_CHANNEL_ID=
