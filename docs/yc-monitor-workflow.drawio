        <mxCell id="p2title" value="Social Post Classification — GPTSocialClassifier.classify()&#10;gpt_classify.py:229-433  ·  outcomes: ACCEPT / REVIEW / REJECT / DEFER" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="p2-1">
