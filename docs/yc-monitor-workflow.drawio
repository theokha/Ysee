        <mxCell id="n5" value="&lt;b&gt;_judge()&lt;/b&gt; — OpenAI client.responses.parse&lt;br&gt;model = settings.openai_model (default &lt;b&gt;gpt-5.6-luna&lt;/b&gt;)&lt;br&gt;SYSTEM_PROMPT + user JSON {source, author_name, author_handle,&lt;br&gt;existing_company, url, text[:3000]}&lt;br&gt;bounded by openai_max_concurrency / timeout / retries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p2-1">
          <mxGeometry x="620" y="650" width="440" height="110" as="geometry" />
        </mxCell>
