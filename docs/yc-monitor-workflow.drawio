        <mxCell id="n7" value="&lt;b&gt;SocialJudgement&lt;/b&gt; (structured output)&lt;br&gt;is_founder_self_announcement · is_first_party · is_current_announcement&lt;br&gt;is_accelerator_acceptance · is_product_launch_only · is_retrospective&lt;br&gt;is_satire_or_joke · is_third_party_report&lt;br&gt;signal_kind ∈ {first_party_acceptance, first_party_launch, new_company_report, none}&lt;br&gt;company_name · product_name · company_handle · program · batch&lt;br&gt;evidence_quotes[] · confidence · reason · noise_type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="p2-1">
