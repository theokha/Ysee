          <mxGeometry x="640" y="370" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fb1" value="&lt;b&gt;FALLBACK&lt;/b&gt; — return the heuristic&lt;br&gt;classify_social() result verbatim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;" vertex="1" parent="p2-1">
