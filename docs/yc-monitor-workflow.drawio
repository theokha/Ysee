        <mxCell id="acc" value="&lt;b&gt;ACCEPT&lt;/b&gt; — gpt_confirmed:{reason}&lt;br&gt;&lt;br&gt;_alert_kind():&lt;br&gt;&#160;&#160;&quot;speedrun&quot; in program&#160;&#160;→ EARLY_SPEEDRUN_LAUNCH&lt;br&gt;&#160;&#160;acceptance ∧ ¬launch_only&#160;&#160;→ EARLY_FOUNDER&lt;br&gt;&#160;&#160;else&#160;&#160;→ EARLY_YC_LAUNCH&lt;br&gt;&lt;br&gt;→ seen_items &quot;evidence&quot; + slack_outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="p2-1">
          <mxGeometry x="600" y="2450" width="480" height="150" as="geometry" />
        </mxCell>

        <mxCell id="heur" value="&lt;b&gt;classify.py — classify_social() heuristic (fallback only)&lt;/b&gt;&lt;br&gt;Runs when GPT is disabled, or on API error &lt;i&gt;if it already produced an alert&lt;/i&gt;.&lt;br&gt;It can never override a GPT reject/review.&lt;br&gt;&lt;br&gt;Ordered gates:&lt;br&gt;1. company_page_skip (item_id starts &quot;company:&quot;)&lt;br&gt;2. empty_content&lt;br&gt;3. founder_already_official&lt;br&gt;4. excluded_intent — REJECT regex (applied/interview/hiring/congratulations to/...)&lt;br&gt;5. FIRST_PERSON ∧ ACCEPTANCE ∧ PROGRAM all present&lt;br&gt;6. company_already_official (exact, fuzzy ≥ 0.92, or token-subset)&lt;br&gt;7. website_already_official (host in official_hosts)&lt;br&gt;→ ACCEPT AlertKind.EARLY_FOUNDER&lt;br&gt;&#160;&#160;&#160;confidence = 0.75 (+0.10 batch code) (+0.10 company extracted), cap 1.0&lt;br&gt;&#160;&#160;&#160;dedup_key = early:{normalized_company}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="p2-1">
          <mxGeometry x="90" y="2450" width="470" height="300" as="geometry" />
        </mxCell>

        <mxCell id="p2e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="p2-1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="p2-1" source="n2" target="rj1"><mxGeometry relative="1" as="geometry" /></mxCell>
