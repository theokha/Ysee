        <mxCell id="title" value="YC Launch Monitor — End-to-End Workflow&#10;(MonitorPipeline.run — pipeline.py:274)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="0" width="900" height="50" as="geometry" />
        </mxCell>

        <mxCell id="laneOff" value="OFFICIAL / CATALOG PATH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="640" width="690" height="920" as="geometry" />
        </mxCell>
        <mxCell id="laneSoc" value="SOCIAL PATH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="740" y="640" width="760" height="920" as="geometry" />
        </mxCell>
        <mxCell id="laneDel" value="DELIVERY &amp;amp; CLOSE-OUT (skipped entirely when dry_run=True)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="20" y="1600" width="1480" height="400" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="&lt;b&gt;APScheduler&lt;/b&gt;&lt;br&gt;interval job &lt;i&gt;monitor-cycle&lt;/i&gt;&lt;br&gt;every poll_interval_hours (1–48)&lt;br&gt;first fire: +30s or +interval&lt;br&gt;max_instances=1, coalesce&lt;br&gt;&lt;i&gt;scheduler.py:7-40&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="70" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;CLI&lt;/b&gt; python -m yc_monitor&lt;br&gt;serve | run-once [--dry-run]&lt;br&gt;status | leads | audit &amp;lt;run_id&amp;gt;&lt;br&gt;test-alert&lt;br&gt;&lt;i&gt;__main__.py:16-50&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="p1-1">
          <mxGeometry x="370" y="70" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;Slack slash commands&lt;/b&gt;&lt;br&gt;/yc scan · /yc scan dry · /yc review&lt;br&gt;/yc retry  (admin-gated)&lt;br&gt;POST /slack/commands, HMAC v0&lt;br&gt;&lt;i&gt;slack_app.py:131-181&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="p1-1">
          <mxGeometry x="700" y="70" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;Pond agent API&lt;/b&gt;&lt;br&gt;POST /runs (Bearer pond_access_key)&lt;br&gt;run_monitor_cycle | get_status | list_leads&lt;br&gt;idempotent via pond_responses&lt;br&gt;&lt;i&gt;pond_server.py:298-346&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="p1-1">
          <mxGeometry x="1050" y="70" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="pRun" value="&lt;b&gt;MonitorPipeline.run(dry_run)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="p1-1">
          <mxGeometry x="620" y="215" width="360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="pRt" value="apply_runtime_settings(db, base_settings)&lt;br&gt;overlay &lt;i&gt;runtime_settings&lt;/i&gt; rows onto .env defaults&lt;br&gt;&lt;i&gt;runtime_settings.py:170-186&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="620" y="300" width="360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="dThr" value="thresholds ordered?&lt;br&gt;min ≤ review ≤ immediate" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-1">
          <mxGeometry x="670" y="405" width="260" height="95" as="geometry" />
        </mxCell>
        <mxCell id="nRevert" value="revert to previous settings&lt;br&gt;(log warning — an inverted band&lt;br&gt;would queue everything)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p1-1">
          <mxGeometry x="990" y="415" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="pStart" value="if settings changed → build_adapters() + _sync_classifier_limits()&lt;br&gt;&lt;b&gt;db.start_run(run_id)&lt;/b&gt; → &lt;i&gt;runs&lt;/i&gt;   ·   classifier.begin_cycle()&lt;br&gt;httpx.AsyncClient(User-Agent: YCLaunchMonitor/1.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="570" y="535" width="460" height="70" as="geometry" />
        </mxCell>

        <mxCell id="OA" value="&lt;b&gt;OFFICIAL ADAPTERS&lt;/b&gt; — sequential _safe_collect()&lt;br&gt;&lt;br&gt;• &lt;b&gt;YCDirectoryAdapter&lt;/b&gt; → GET yc-oss.github.io/api/companies/all.json&lt;br&gt;&#160;&#160;&#160;+ changes/latest.json probe (non-fatal, 15s)&lt;br&gt;• &lt;b&gt;YCSpeedrunAdapter&lt;/b&gt; → GET speedrun-api.a16z.com/api/companies/ (paginated)&lt;br&gt;&#160;&#160;&#160;SKIPPED when YC_SPEEDRUN_URL unset&lt;br&gt;• &lt;b&gt;YCLaunchesAdapter&lt;/b&gt; → GET ycombinator.com/launches (JSON hits)&lt;br&gt;&lt;br&gt;each → CollectionResult(items: CanonicalItem[], health: AdapterHealth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="p1-1">
          <mxGeometry x="45" y="690" width="640" height="140" as="geometry" />
        </mxCell>
        <mxCell id="OB" value="record_audit_decision(stage=&quot;official_ingest&quot;, outcome=&quot;collected&quot;) → &lt;i&gt;audit_decisions&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="105" y="860" width="520" height="45" as="geometry" />
        </mxCell>
        <mxCell id="OC" value="ingest_official_result() — routes by Source&lt;br&gt;&lt;i&gt;pipeline.py:47&lt;/i&gt;  ·  upsert_yc_company() → &lt;i&gt;yc_companies&lt;/i&gt; (names, aliases, host, founder handles)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="105" y="935" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="OD" value="bootstrapped?&lt;br&gt;app_state[*_bootstrap_complete]" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-1">
          <mxGeometry x="190" y="1020" width="350" height="95" as="geometry" />
        </mxCell>
        <mxCell id="ODno" value="reserve_item(&quot;baseline&quot;)&lt;br&gt;seed catalog only — no alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="1145" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="OE" value="eligible?&lt;br&gt;YC dir: new slug AND published_at ≥ now − yc_official_alert_max_age_days (7)&lt;br&gt;others: not has_seen_item(dedup_key)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-1">
          <mxGeometry x="290" y="1145" width="390" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ODrop" value="skip — already known&lt;br&gt;or stale restoration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;" vertex="1" parent="p1-1">
          <mxGeometry x="50" y="1290" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="OF" value="find_early_alert_key(company_name)&lt;br&gt;→ upgrade_from / upgrade_note (&quot;previously an early founder signal&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="290" y="1285" width="390" height="65" as="geometry" />
        </mxCell>
        <mxCell id="OG" value="&lt;b&gt;official_alert()&lt;/b&gt; → AlertKind.OFFICIAL_YC | OFFICIAL_SPEEDRUN&lt;br&gt;dedup_key: yc:{item_id} | speedrun:{name} | launch:{item_id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p1-1">
          <mxGeometry x="240" y="1385" width="440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="OH" value="db.reserve_alert(alert) → &lt;i&gt;slack_outbox&lt;/i&gt; (pending)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p1-1">
          <mxGeometry x="270" y="1485" width="380" height="45" as="geometry" />
        </mxCell>

        <mxCell id="SA" value="&lt;b&gt;SOCIAL ADAPTERS&lt;/b&gt; — _safe_collect()&lt;br&gt;&lt;br&gt;• &lt;b&gt;TwitterAdapter&lt;/b&gt; → GET api.twitterapi.io/twitter/tweet/advanced_search&lt;br&gt;&#160;&#160;&#160;queries + &quot;since_time:{now − twitter_lookback_days}&quot;, cursor paging ×max_pages, drops replies&lt;br&gt;&#160;&#160;&#160;SKIPPED without TWITTERAPI_IO_API_KEY&lt;br&gt;• &lt;b&gt;LinkedInAdapter&lt;/b&gt; → POST api.apify.com/v2/acts/{actor}/runs → GET dataset items&lt;br&gt;&#160;&#160;&#160;HarvestAPI actor, postedLimit=week, client-side cut at linkedin_window_hours (36)&lt;br&gt;&#160;&#160;&#160;SKIPPED without APIFY_API_TOKEN&lt;br&gt;&lt;br&gt;adapter failure → HealthStatus.FAILED, cycle continues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="p1-1">
          <mxGeometry x="760" y="690" width="720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="SB" value="filter: not db.has_seen_item(&quot;{source}:{item_id}&quot;)  — cross-cycle dedup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="830" y="880" width="580" height="45" as="geometry" />
        </mxCell>
        <mxCell id="SC" value="db.official_identities() → (names, hosts, founder_handles) from &lt;i&gt;yc_companies&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="830" y="950" width="580" height="45" as="geometry" />
        </mxCell>
        <mxCell id="SD" value="_classify_social_items() — asyncio.gather, per-item try/except&lt;br&gt;one bad item defers itself instead of failing the run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="830" y="1020" width="580" height="55" as="geometry" />
        </mxCell>
        <mxCell id="SE" value="&lt;b&gt;GPTSocialClassifier.classify()&lt;/b&gt;&lt;br&gt;prefilter → OpenAI → decision tree — &lt;i&gt;see Page 2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1" vertex="1" parent="p1-1">
          <mxGeometry x="880" y="1100" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="SF" value="record_audit_decision(stage=&quot;classify&quot;, outcome ∈ alert | review | rejected | deferred)&lt;br&gt;+ raw payload → &lt;i&gt;audit_decisions&lt;/i&gt;   ·   put_state(&quot;watermark:{source}&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="830" y="1190" width="580" height="55" as="geometry" />
        </mxCell>
        <mxCell id="SG" value="classification.persist?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-1">
          <mxGeometry x="900" y="1275" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="SGno" value="&lt;b&gt;deferred&lt;/b&gt;&lt;br&gt;not written to&lt;br&gt;seen_items —&lt;br&gt;retried next cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;" vertex="1" parent="p1-1">
          <mxGeometry x="1340" y="1280" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="R1" value="&lt;b&gt;alert&lt;/b&gt;&lt;br&gt;reserve_item(&quot;evidence&quot;)&lt;br&gt;+ reserve_alert(run_id)&lt;br&gt;→ slack_outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p1-1">
          <mxGeometry x="765" y="1410" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="&lt;b&gt;reason starts &quot;gpt_review:&quot;&lt;/b&gt;&lt;br&gt;reserve_item(&quot;review&quot;)&lt;br&gt;→ review queue&lt;br&gt;+ ops review digest (≤8 names)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p1-1">
          <mxGeometry x="1010" y="1410" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="R3" value="&lt;b&gt;otherwise&lt;/b&gt;&lt;br&gt;reserve_item(&quot;rejected&quot;)&lt;br&gt;no Slack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p1-1">
          <mxGeometry x="1255" y="1410" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="DL1" value="&lt;b&gt;deliver_outbox()&lt;/b&gt;&lt;br&gt;list_undelivered_alerts() — pending + failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="90" y="1660" width="330" height="55" as="geometry" />
        </mxCell>
        <mxCell id="DL2" value="slack_thread_for_early_key(upgrade_from)&lt;br&gt;→ post as a thread reply under the original early-signal alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="90" y="1740" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="DL3" value="SlackNotifier.send → AsyncWebClient.chat_postMessage&lt;br&gt;format_alert() Block Kit — header by AlertKind, fields,&lt;br&gt;quoted post, URL link buttons (no action_id / no interactivity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="90" y="1825" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="DL4" value="posted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-1">
          <mxGeometry x="470" y="1820" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="DL5" value="mark_outbox_sent(channel, ts)&lt;br&gt;+ seen_items → &quot;alerted&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p1-1">
          <mxGeometry x="720" y="1755" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="DL6" value="mark_outbox_failed(error)&lt;br&gt;retried next cycle or via /yc retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p1-1">
          <mxGeometry x="720" y="1885" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="DL7" value="_notify_source_health(health)&lt;br&gt;2 consecutive FAILED → ops channel &quot;Monitor degraded&quot;&lt;br&gt;recovery → &quot;{source} monitor recovered&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="1040" y="1660" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="DL8" value="put_state: last_gpt_stats, last_usage&lt;br&gt;(twitter_posts, linkedin_posts, review_count, gpt) → &lt;i&gt;app_state&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="1040" y="1765" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="DL9" value="&lt;b&gt;finish_run(run_id, completed|failed, alert_count, health)&lt;/b&gt; → &lt;i&gt;runs&lt;/i&gt;&lt;br&gt;returns {run_id, status, alert_count, alerts[], delivered_count, gpt, health[]}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p1-1">
          <mxGeometry x="1040" y="1865" width="330" height="75" as="geometry" />
        </mxCell>

        <mxCell id="noteDry" value="&lt;b&gt;dry_run=True&lt;/b&gt;: adapters still fetch and items still classify, but nothing is reserved in seen_items / slack_outbox, no watermarks or usage state are written, and delivery + health notices are skipped. Alerts are only returned in the response payload." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="p1-1">
          <mxGeometry x="1050" y="215" width="400" height="150" as="geometry" />
        </mxCell>

