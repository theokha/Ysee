  <diagram id="page3" name="3 · Data Stores, Review Loop &amp; Control Surface">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0">
      <root>
        <mxCell id="p3-0" />
        <mxCell id="p3-1" parent="p3-0" />

        <mxCell id="p3title" value="Data Stores, Human Review Loop &amp;amp; Control Surface" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="10" width="900" height="40" as="geometry" />
        </mxCell>

        <mxCell id="dbHdr" value="SQLite — data/monitor.db (db.py:54-138)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#666666;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="70" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="db1" value="&lt;b&gt;seen_items&lt;/b&gt; — PK dedup_key. Dedup + disposition store &lt;i&gt;and&lt;/i&gt; the review queue.&lt;br&gt;disposition: baseline · pending · alerted · evidence · review · rejected · archived" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;size=12;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="110" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="db2" value="&lt;b&gt;yc_companies&lt;/b&gt; — official identity catalog: names, aliases, website host, founder handles.&lt;br&gt;Written by ingest_yc_directory; read as the suppression set on every social classify." style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;size=12;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="215" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="db3" value="&lt;b&gt;slack_outbox&lt;/b&gt; — delivery queue / retry. status: pending | failed | sent.&lt;br&gt;Stores the serialized Alert + slack_ts so upgrades thread under the original post." style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;size=12;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="320" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="db4" value="&lt;b&gt;audit_decisions&lt;/b&gt; — append-only trail of every stage outcome, &lt;i&gt;including deferred/capped items that never reach seen_items&lt;/i&gt;. Stores the raw payload for replay." style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;size=12;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="425" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="db5" value="&lt;b&gt;runs&lt;/b&gt; — per-cycle log: status, alert_count, adapter health, error." style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;size=12;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="530" width="560" height="75" as="geometry" />
        </mxCell>
        <mxCell id="db6" value="&lt;b&gt;app_state&lt;/b&gt; — KV runtime state: *_bootstrap_complete, last_gpt_stats, last_usage,&lt;br&gt;scheduler_next_run, watermark:{source}, budget:openai_calls:{date}, source_fail:{source}" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;size=12;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="620" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="db7" value="&lt;b&gt;runtime_settings&lt;/b&gt; — (key, value, updated_at) overrides from /yc config set; survives restart, applied at the next cycle." style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;size=12;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="725" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="db8" value="&lt;b&gt;slack_install&lt;/b&gt; — OAuth bot token per team_id (fallback when SLACK_BOT_TOKEN unset)." style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;size=12;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="825" width="560" height="75" as="geometry" />
        </mxCell>
        <mxCell id="db9" value="&lt;b&gt;pond_responses&lt;/b&gt; — idempotency cache for POST /runs." style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;size=12;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="915" width="560" height="70" as="geometry" />
        </mxCell>

        <mxCell id="rvHdr" value="Human review loop — /yc review → rejudge_review_queue() (pipeline.py:445)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#666666;" vertex="1" parent="p3-1">
          <mxGeometry x="700" y="70" width="620" height="30" as="geometry" />
        </mxCell>

        <mxCell id="rvA" value="&lt;b&gt;/yc review&lt;/b&gt; (admin) → rejudge_review_queue(limit=25)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p3-1">
          <mxGeometry x="720" y="110" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rvB" value="db.list_review_rows(25) — seen_items WHERE disposition = &quot;review&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p3-1">
          <mxGeometry x="720" y="185" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rvC" value="_item_from_review_row(row) — rebuild the CanonicalItem from the stored raw payload&lt;br&gt;(author, handle and post text are recovered, not re-fetched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p3-1">
          <mxGeometry x="720" y="260" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rvD" value="reviewed &amp;lt; openai_max_calls_per_cycle?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p3-1">
          <mxGeometry x="760" y="345" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="rvE" value="social_classifier.classify(item, names, hosts, handles)&lt;br&gt;&lt;i&gt;re-judged with the current thresholds and prompt&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p3-1">
          <mxGeometry x="720" y="460" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="rvF1" value="&lt;b&gt;PROMOTED&lt;/b&gt;&lt;br&gt;alert → reserve_item(&quot;evidence&quot;)&lt;br&gt;+ reserve_alert()&lt;br&gt;+ resolve_review(&quot;evidence&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p3-1">
          <mxGeometry x="700" y="560" width="255" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rvF2" value="&lt;b&gt;STILL DEFERRED&lt;/b&gt;&lt;br&gt;gpt_review:* → stays in the queue&lt;br&gt;&lt;i&gt;a second review verdict must never&lt;br&gt;become a permanent rejection&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p3-1">
          <mxGeometry x="985" y="560" width="255" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rvF3" value="&lt;b&gt;CLEARED&lt;/b&gt;&lt;br&gt;persist → resolve_review(&quot;rejected&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p3-1">
          <mxGeometry x="700" y="670" width="255" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rvF4" value="&lt;b&gt;DEFERRED&lt;/b&gt;&lt;br&gt;persist=False, cap hit,&lt;br&gt;bad payload or classify error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;" vertex="1" parent="p3-1">
          <mxGeometry x="985" y="670" width="255" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rvG" value="if promoted → deliver_outbox() → Slack&lt;br&gt;returns {reviewed, promoted[], cleared, deferred, promoted_alerts[], promoted_names[], delivered}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p3-1">
          <mxGeometry x="720" y="775" width="520" height="65" as="geometry" />
        </mxCell>

        <mxCell id="arHdr" value="Offline audit replay — audit_replay.py (never runs inside a cycle)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#666666;" vertex="1" parent="p3-1">
          <mxGeometry x="700" y="880" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ar1" value="CLI &lt;b&gt;audit &amp;lt;run_id&amp;gt;&lt;/b&gt; → summarize_run(db, run_id)&lt;br&gt;aggregate outcomes + reasons, list alert keys — no reclassification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p3-1">
          <mxGeometry x="720" y="920" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ar2" value="&lt;b&gt;replay_run(db, classifier, run_id)&lt;/b&gt;&lt;br&gt;re-runs classify on captured stage=&quot;classify&quot; rows&lt;br&gt;&lt;b&gt;no collect · no DB write · no Slack&lt;/b&gt;&lt;br&gt;emits old→new transition counts over&lt;br&gt;alert | review | rejected | deferred | unparseable&lt;br&gt;&lt;i&gt;the safe way to evaluate a threshold or prompt change&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p3-1">
          <mxGeometry x="720" y="1000" width="520" height="120" as="geometry" />
        </mxCell>

        <mxCell id="scHdr" value="HTTP + Slack control surface (pond_server.py · slack_app.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#666666;" vertex="1" parent="p3-1">
          <mxGeometry x="1320" y="70" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc1" value="&lt;b&gt;FastAPI app&lt;/b&gt; (create_app) — started by `serve`, hosts APScheduler&lt;br&gt;&lt;br&gt;GET&#160;&#160;/healthz&lt;br&gt;GET&#160;&#160;/manifest&lt;br&gt;POST /runs&#160;&#160;(Bearer pond_access_key, idempotent)&lt;br&gt;GET&#160;&#160;/tasks/{task_id}&lt;br&gt;GET&#160;&#160;/slack/install&#160;&#160;→ OAuth start&lt;br&gt;GET&#160;&#160;/slack/oauth_redirect → slack_install&lt;br&gt;POST /slack/commands&#160;&#160;(HMAC v0 signature verify)&lt;br&gt;&lt;br&gt;Lifespan: archive_known_noise → build_scheduler →&lt;br&gt;persist scheduler_next_run → start + schedule_first_run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="p3-1">
          <mxGeometry x="1320" y="110" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="sc2" value="&lt;b&gt;Slash commands&lt;/b&gt; — /yc and /yc-status (Web API, not Bolt/Socket Mode)&lt;br&gt;&lt;br&gt;/yc  |  /yc status&#160;&#160;→ status blocks&lt;br&gt;/yc help&lt;br&gt;/yc config [show]&lt;br&gt;/yc config set &amp;lt;key&amp;gt; &amp;lt;value&amp;gt;&#160;&#160;*&lt;br&gt;/yc config reset &amp;lt;key&amp;gt;&#160;&#160;*&lt;br&gt;/yc scan  |  /yc scan dry&#160;&#160;*&lt;br&gt;/yc review&#160;&#160;*&lt;br&gt;/yc leads&lt;br&gt;/yc retry&lt;br&gt;&lt;br&gt;* admin-gated by slack_admin_users&lt;br&gt;Long actions ack immediately, then run in the background&lt;br&gt;&lt;b&gt;No interactive components&lt;/b&gt; — alert buttons are URL links only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="p3-1">
          <mxGeometry x="1320" y="370" width="560" height="290" as="geometry" />
        </mxCell>
        <mxCell id="sc3" value="&lt;b&gt;Runtime-tunable&lt;/b&gt; via /yc config set → runtime_settings&lt;br&gt;&lt;br&gt;poll_interval_hours&#160;&#160;1–48&lt;br&gt;openai_min_confidence&#160;&#160;0–1&lt;br&gt;openai_immediate_min_confidence&#160;&#160;0–1&lt;br&gt;openai_max_calls_per_cycle&#160;&#160;0–200&lt;br&gt;openai_max_calls_per_day&#160;&#160;0–2000&lt;br&gt;twitter_lookback_days&#160;&#160;1–30&lt;br&gt;twitter_current_batches&#160;&#160;[SWF]dd csv, 1–6&lt;br&gt;linkedin_total_posts&#160;&#160;1–100&lt;br&gt;yc_official_alert_max_age_days&#160;&#160;1–30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="p3-1">
          <mxGeometry x="1320" y="690" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sc4" value="&lt;b&gt;Env-fixed&lt;/b&gt; (.env only — restart required)&lt;br&gt;&lt;br&gt;openai_model&#160;&#160;(default gpt-5.6-luna)&lt;br&gt;&lt;b&gt;openai_review_min_confidence&#160;&#160;0.65 — NOT Slack-tunable&lt;/b&gt;&lt;br&gt;openai_timeout_seconds / max_retries / max_concurrency&lt;br&gt;API keys (OpenAI, TwitterAPI.io, Apify, Slack, Pond)&lt;br&gt;database_path · port · log_level · public_base_url&lt;br&gt;slack_admin_users · slack_channel_id · slack_ops_channel_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="p3-1">
          <mxGeometry x="1320" y="920" width="560" height="170" as="geometry" />
        </mxCell>

        <mxCell id="p3e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="p3-1" source="rvA" target="rvB"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="p3-1" source="rvB" target="rvC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="p3-1" source="rvC" target="rvD"><mxGeometry relative="1" as="geometry" /></mxCell>
