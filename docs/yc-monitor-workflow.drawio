        <mxCell id="df1" value="&lt;b&gt;DEFER&lt;/b&gt; persist=False&lt;br&gt;gpt_cycle_budget_exhausted&lt;br&gt;never stored → retried next cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;" vertex="1" parent="p2-1">
