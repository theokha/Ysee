        <mxCell id="n2" value="&lt;b&gt;cheap_prefilter&lt;/b&gt; hit?&lt;br&gt;empty_content · founder_already_official · missing_program_reference&lt;br&gt;retrospective_not_current_announcement · invalid_yc_batch_code&lt;br&gt;yc_affiliation_without_current_acceptance" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2-1">
