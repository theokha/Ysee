        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;green = ACCEPT → alert&lt;br&gt;orange = REVIEW → queue (&quot;gpt_review:*&quot;)&lt;br&gt;red = REJECT → seen_items &quot;rejected&quot;&lt;br&gt;grey = DEFER (persist=False, retried)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="p2-1">
          <mxGeometry x="1200" y="0" width="380" height="110" as="geometry" />
