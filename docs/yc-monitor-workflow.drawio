        </mxCell>
        <mxCell id="er1" value="fallback.alert exists?&lt;br&gt;&lt;b&gt;Yes&lt;/b&gt; → ACCEPT the heuristic alert&lt;br&gt;&lt;b&gt;No&lt;/b&gt; → DEFER openai_classification_deferred (persist=False)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;" vertex="1" parent="p2-1">
          <mxGeometry x="1180" y="795" width="400" height="90" as="geometry" />
