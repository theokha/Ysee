        <mxCell id="g7" value="suppress_official (founder / company name / website host)&lt;br&gt;OR company_handle already an official handle?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2-1">
          <mxGeometry x="620" y="1970" width="440" height="115" as="geometry" />
        </mxCell>
        <mxCell id="rj4" value="&lt;b&gt;REJECT&lt;/b&gt; — already known to be YC&lt;br&gt;founder_already_official | company_already_official&lt;br&gt;website_already_official | company_handle_already_official" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p2-1">
