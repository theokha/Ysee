          <mxGeometry x="640" y="2310" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="rv6" value="&lt;b&gt;REVIEW&lt;/b&gt;&lt;br&gt;gpt_review:unresolved_product_owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p2-1">
          <mxGeometry x="1180" y="2320" width="400" height="60" as="geometry" />
